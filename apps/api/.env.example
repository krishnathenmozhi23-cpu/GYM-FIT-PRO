# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://gymfit:gymfit@localhost:5432/gymfit
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_HOURS=168
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# AI provider: anthropic | mock | none
#   none      -> deterministic rule engine only (no LLM calls)
#   mock      -> development mock provider (responses labelled dev_mock)
#   anthropic -> Claude via the official SDK; set ANTHROPIC_API_KEY
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000
# ANTHROPIC_API_KEY=

# Production single-process deployment: serve the API under /api and the
# built web app (npm run build) from the same server.
# API_PREFIX=/api
# WEB_DIST_DIR=../web/dist

# Public URL of the web app (used in emailed links)
APP_URL=http://localhost:5173
# Email: console (DEV ONLY — logs emails incl. links) | disabled (reset/verify return 503).
# Defaults: console in development/test, disabled in production. Production needs a real
# provider implemented behind the Mailer interface in src/lib/mailer.ts.
# MAIL_PROVIDER=console
